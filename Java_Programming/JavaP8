# A: Construct a simple calculator using Java Swing with minimum functionality. 
package javaapplication10;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class cal extends JFrame implements ActionListener {

    JTextField txtNum1, txtNum2;
    JButton btnAdd, btnSub, btnMul, btnDiv, btnClear;
    JLabel lblResult;

    public cal() {

        // Window settings
        setTitle("Calculator");
        setSize(450, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        // Main panel
        JPanel panel = new JPanel();
        panel.setLayout(new GridLayout(6, 2, 12, 12));
        panel.setBorder(BorderFactory.createEmptyBorder(20, 25, 20, 25));
        panel.setBackground(new Color(240, 245, 250));

        JLabel title = new JLabel("S116 CALCULATOR", JLabel.CENTER);
        title.setFont(new Font("Times New Roman", Font.BOLD, 24));
        title.setForeground(new Color(30, 70, 120));

        JLabel lblNum1 = new JLabel("Enter Number 1:");
        lblNum1.setFont(new Font("Times New Roman", Font.BOLD, 15));

        txtNum1 = new JTextField();
        txtNum1.setFont(new Font("Times New Roman", Font.PLAIN, 16));

        JLabel lblNum2 = new JLabel("Enter Number 2:");
        lblNum2.setFont(new Font("Times New Roman", Font.BOLD, 15));

        txtNum2 = new JTextField();
        txtNum2.setFont(new Font("Times New Roman", Font.PLAIN, 16));

        btnAdd = new JButton("+");
        btnSub = new JButton("-");
        btnMul = new JButton("*");
        btnDiv = new JButton("/");
        btnClear = new JButton("CLEAR");

        styleButton(btnAdd, new Color(76, 175, 80));
        styleButton(btnSub, new Color(33, 150, 243));
        styleButton(btnMul, new Color(255, 152, 0));
        styleButton(btnDiv, new Color(156, 39, 176));
        styleButton(btnClear, new Color(220, 53, 69));

        JLabel resultText = new JLabel("Result:");
        resultText.setFont(new Font("Times New Roman", Font.BOLD, 15));

        lblResult = new JLabel(" ");
        lblResult.setFont(new Font("Times New Roman", Font.BOLD, 18));
        lblResult.setForeground(new Color(30, 70, 120));

        add(title, BorderLayout.NORTH);

        panel.add(lblNum1);
        panel.add(txtNum1);

        panel.add(lblNum2);
        panel.add(txtNum2);

        panel.add(btnAdd);
        panel.add(btnSub);

        panel.add(btnMul);
        panel.add(btnDiv);

        panel.add(resultText);
        panel.add(lblResult);

        panel.add(new JLabel(""));
        panel.add(btnClear);

        add(panel, BorderLayout.CENTER);

        btnAdd.addActionListener(this);
        btnSub.addActionListener(this);
        btnMul.addActionListener(this);
        btnDiv.addActionListener(this);
        btnClear.addActionListener(this);

        setVisible(true);
    }

    public void styleButton(JButton button, Color color) {

        button.setFont(new Font("Times New Roman", Font.BOLD, 18));
        button.setForeground(Color.WHITE);
        button.setBackground(color);
        button.setFocusPainted(false);
    }

    @Override
    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == btnClear) {

            txtNum1.setText("");
            txtNum2.setText("");
            lblResult.setText(" ");

            return;
        }

        try {

            double a = Double.parseDouble(txtNum1.getText());
            double b = Double.parseDouble(txtNum2.getText());

            double result = 0;

            if (e.getSource() == btnAdd) {

                result = a + b;

            } else if (e.getSource() == btnSub) {

                result = a - b;

            } else if (e.getSource() == btnMul) {

                result = a * b;

            } else if (e.getSource() == btnDiv) {

                if (b == 0) {

                    lblResult.setText("Cannot divide by zero");
                    return;
                }

                result = a / b;
            }

            lblResult.setText(String.valueOf(result));

        } catch (NumberFormatException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please enter valid numbers.",
                    "Invalid Input",
                    JOptionPane.WARNING_MESSAGE
            );
        }
    }

    public static void main(String[] args) {

        new cal();
    }
}


# B:Construct a GUI using Java Swing to accept the details of a record of a given table and submit it to the database using JDBC technology of a click button .
# SQL Code -
create database cllg;
use cllg;
create table student (id int primary key, name varchar(50), course varchar(50), marks int);
desc student;
insert into student values(101, 'Rahul', 'BCA', 85);
select * from student;

#Code -
package calculator;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.sql.*;

public class StudentFormprac extends JFrame implements ActionListener {

    JLabel idLabel, nameLabel, courseLabel, marksLabel;
    JTextField idText, nameText, courseText, marksText;
    JButton submitButton;
    JTextArea outputArea;

    StudentFormprac() {

        setTitle("Student Record");
        setSize(500, 450);
        setLayout(null);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        // Title
        JLabel title = new JLabel("STUDENT RECORD");
        title.setFont(new Font("Arial", Font.BOLD, 20));
        title.setForeground(new Color(0, 51, 102));
        title.setBounds(170, 20, 200, 30);
        add(title);

        // Student ID
        idLabel = new JLabel("Student ID:");
        idLabel.setBounds(50, 70, 100, 30);
        add(idLabel);

        idText = new JTextField();
        idText.setBounds(160, 70, 200, 30);
        add(idText);

        // Name
        nameLabel = new JLabel("Name:");
        nameLabel.setBounds(50, 110, 100, 30);
        add(nameLabel);

        nameText = new JTextField();
        nameText.setBounds(160, 110, 200, 30);
        add(nameText);

        // Course
        courseLabel = new JLabel("Course:");
        courseLabel.setBounds(50, 150, 100, 30);
        add(courseLabel);

        courseText = new JTextField();
        courseText.setBounds(160, 150, 200, 30);
        add(courseText);

        // Marks
        marksLabel = new JLabel("Marks:");
        marksLabel.setBounds(50, 190, 100, 30);
        add(marksLabel);

        marksText = new JTextField();
        marksText.setBounds(160, 190, 200, 30);
        add(marksText);

        // Submit Button
        submitButton = new JButton("Submit");
        submitButton.setBounds(200, 235, 100, 35);
        submitButton.setBackground(new Color(0, 51, 102));
        submitButton.setForeground(Color.WHITE);
        add(submitButton);

        submitButton.addActionListener(this);

        // Output Area
        outputArea = new JTextArea();
        outputArea.setEditable(false);
        outputArea.setFont(new Font("Monospaced", Font.PLAIN, 13));

        JScrollPane scrollPane = new JScrollPane(outputArea);
        scrollPane.setBounds(50, 290, 400, 100);
        add(scrollPane);

        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == submitButton) {

            try {

                Class.forName("com.mysql.jdbc.Driver");

                Connection con = DriverManager.getConnection(
                    "jdbc:mysql://localhost:3306/cllg",
                    "root",
                    "root"
                );

                String sql = "INSERT INTO student VALUES (?, ?, ?, ?)";

                PreparedStatement ps = con.prepareStatement(sql);

                int id = Integer.parseInt(idText.getText());
                String name = nameText.getText();
                String course = courseText.getText();
                int marks = Integer.parseInt(marksText.getText());

                ps.setInt(1, id);
                ps.setString(2, name);
                ps.setString(3, course);
                ps.setInt(4, marks);

                ps.executeUpdate();

                JOptionPane.showMessageDialog(
                    this,
                    "Record inserted successfully!"
                );

                outputArea.setText("");
                outputArea.append("ID\tNAME\tCOURSE\tMARKS\n");
                outputArea.append("----------------------------------------\n");
                outputArea.append(
                    id + "\t" + name + "\t" + course + "\t" + marks
                );

                con.close();

            } catch (Exception ex) {

                JOptionPane.showMessageDialog(
                    this,
                    "Error: " + ex.getMessage()
                );
            }
        }
    }

    public static void main(String[] args) {
        new StudentFormprac();
    }
}

