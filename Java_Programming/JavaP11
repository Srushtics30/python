# A. Write a Servlet that accepts a User Name from a HTML form and stores it as a cookie. Write another Servlet that returns the value of this cookie and displays it. 
# index.html
<!DOCTYPE html>
<html>
<head>
    <title>Cookie Example</title>
</head>
<body>

<h2>Enter User Name</h2>

<form action="StoreCookieServlet" method="post">
    User Name:
    <input type="text" name="username" required>
    <input type="submit" value="Store Cookie">
</form>

</body>
</html>


# storeCookieServlet.java
import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.Cookie;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet("/StoreCookieServlet")
public class StoreCookieServlet extends HttpServlet {

    protected void doPost(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/html");
        PrintWriter out = response.getWriter();

        String username = request.getParameter("username");

        Cookie cookie = new Cookie("username", username);
        cookie.setMaxAge(60 * 60 * 24);

        response.addCookie(cookie);

        out.println("<h2>Cookie Stored Successfully</h2>");
        out.println("<a href='ReadCookieServlet'>Read Cookie</a>");
    }
}


# readcookieServlet.java
import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.Cookie;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet("/ReadCookieServlet")
public class ReadCookieServlet extends HttpServlet {

    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/html");
        PrintWriter out = response.getWriter();

        Cookie[] cookies = request.getCookies();
        String username = null;

        if (cookies != null) {
            for (Cookie c : cookies) {
                if (c.getName().equals("username")) {
                    username = c.getValue();
                    break;
                }
            }
        }

        out.println("<h2>Cookie Value</h2>");

        if (username != null) {
            out.println("User Name: " + username);
        } else {
            out.println("Cookie not found.");
        }
    }
}


# B.Write a Servlet that displays the names and values of the cookie stored on the client. 
# displayCookiesServlet.java
import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.Cookie;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet(name = "DisplayCookiesServlet", urlPatterns = {"/DisplayCookiesServlet"})
public class DisplayCookiesServlet extends HttpServlet {

    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/html");

        PrintWriter out = response.getWriter();

        Cookie[] cookies = request.getCookies();

        out.println("<html>");
        out.println("<head>");
        out.println("<title>Display Cookies</title>");
        out.println("</head>");
        out.println("<body>");

        out.println("<h2>Cookies Stored on Client</h2>");

        if (cookies != null) {

            for (Cookie c : cookies) {

                out.println("Cookie Name: " + c.getName() + "<br>");
                out.println("Cookie Value: " + c.getValue() + "<br>");
                out.println("<hr>");

            }

        } else {

            out.println("No cookies found.");

        }

        out.println("</body>");
        out.println("</html>");
    }
}


# C.Write a Servlet that accepts a User Name from a HTML form and stores it as a session variable. Write another Servlet that returns the value of this session variable and displays it 
# session.html
<!DOCTYPE html>
<html>
<head>
    <title>Session Example</title>
</head>
<body>

<h2>Enter User Name</h2>

<form action="StoreSessionServlet" method="post">

    User Name:
    <input type="text" name="username" required>

    <br><br>

    <input type="submit" value="Store Session">

</form>

</body>
</html>


# readSessionServlet.java
import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet("/ReadSessionServlet")
public class ReadSessionServlet extends HttpServlet {

    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/html");
        PrintWriter out = response.getWriter();

        String username =
                (String) request.getSession().getAttribute("username");

        out.println("<html><body>");

        out.println("<h2>Session Value</h2>");

        if (username != null) {
            out.println("User Name: " + username);
        } else {
            out.println("Session variable not found.");
        }

        out.println("</body></html>");
    }
}


# storeSessionServlet.java
import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet("/StoreSessionServlet")
public class StoreSessionServlet extends HttpServlet {

    protected void doPost(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/html");
        PrintWriter out = response.getWriter();

        String username = request.getParameter("username");

        request.getSession().setAttribute("username", username);

        out.println("<h2>Session Variable Stored Successfully</h2>");
        out.println("<a href='ReadSessionServlet'>Read Session</a>");
    }
}
