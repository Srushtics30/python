# CPU SCHEDULING - ROUND ROBIN AND FCFS
p = ["P1", "P2", "P3"]
at = [0, 4, 5]
bt = [5, 2, 4]

q = 2

#  ROUND ROBIN 
rem = bt.copy()
ct = [0, 0, 0]
rt = [-1, -1, -1]

queue = []
gantt = []

time = 0

while sum(rem) > 0:

    # Add arrived processes
    for i in range(3):
        if at[i] <= time and rem[i] > 0 and i not in queue:
            queue.append(i)

    # CPU idle
    if not queue:
        time += 1
        continue

    i = queue.pop(0)

    # Response Time
    if rt[i] == -1:
        rt[i] = time - at[i]

    start = time

    # Run for Time Quantum
    run = min(q, rem[i])
    time = time + run
    rem[i] = rem[i] - run

    # Store Gantt chart
    gantt.append([p[i], start, time])

    # Process not completed
    if rem[i] > 0:
        queue.append(i)

    # Process completed
    else:
        ct[i] = time

