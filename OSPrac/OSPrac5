# 1. Write a multi-threaded Python program where each thread calculates the factorial of a different number. Display the factorial result from each thread separately.
import threading

print("S116 - Srushti Vedak \n")
def factorial(n):
    fact = 1
    for i in range(1, n + 1):
        fact = fact * i
    print("Factorial of", n, "=", fact)

numbers = [5, 6, 7]

for n in numbers:
    t = threading.Thread(target=factorial, args=(n,))
    t.start()
    t.join()

print("All threads completed")

# 2. Write a program to print even-odd numbers and reverse a string using the concept of multithreading.
import threading

print("S116 - Srushti Vedak")
# Function to print even numbers
def even():
    for i in range(2, 11, 3):
        print("Even:", i)

# Function to print odd numbers
def odd():
    for i in range(8, 11, 7):
        print("Odd:", i)

# Function to reverse string
def reverse():
    s = input("Enter string: ")
    print("Reverse:", s[::-1])

# Create and run threads
t1 = threading.Thread(target=even)
t1.start()
t1.join()

t2 = threading.Thread(target=odd)
t2.start()
t2.join()

t3 = threading.Thread(target=reverse)
t3.start()
t3.join()

print("All threads completed")
