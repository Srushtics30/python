#  Multi-threading and Fibonacci Generation 
# Implement multi-threading to generate and print Fibonacci sequences. 
# Explore thread safety, synchronization when accessing shared variables. 
# Introduce concepts of thread pooling and task delegation.
import threading

print("S116 - Srushti Vedak")
# function to generate Fibonacci sequence
def generate_fibonacci(n):
    a, b = 0, 1
    sequence = []

    for _ in range(n):
        sequence.append(a)
        a, b = b, a + b

    return sequence

# function to run in each thread
def task(n):
    result = generate_fibonacci(n)
    print(f"Fibonacci({n}) = {result}\n")

if __name__ == "__main__":

    print("Multi-threaded Fibonacci Sequence Generator\n")

    # number of terms to calculate in each thread
    values = [4, 5, 6]

    threads = []

    # create and start threads
    for n in values:
        t = threading.Thread(target=task, args=(n,))
        threads.append(t)
        t.start()

    # wait for all threads to complete
    for t in threads:
        t.join()

    print("\nAll threads completed.")

