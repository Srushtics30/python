# Process Synchronization and Bounded Buffer Problem
# Simulate producer-consumer bounded buffer using mutex and semaphores.
# Implement buffer control with synchronized access.
# Introduce circular queue techniques for managing shared buffers
import threading
import time

print("S116 - Srushti Vedak \n")
BUFFER_SIZE = 5
ITEMS = 10

# Circular buffer
buffer = [None] * BUFFER_SIZE
front = 0
rear = 0

# Semaphores
empty = threading.Semaphore(BUFFER_SIZE)  
full = threading.Semaphore(0)            

# Mutex
mutex = threading.Lock()

def producer():
    global rear

    for item in range(1, ITEMS + 1):
        empty.acquire()      
        mutex.acquire()       

        buffer[rear] = item
        print(f"Producer produced: {item} at position {rear}")

        rear = (rear + 1) % BUFFER_SIZE  

        mutex.release()    
        full.release()        

        time.sleep(1)

def consumer():
    global front

    for _ in range(ITEMS):
        full.acquire()   
        mutex.acquire()      

        item = buffer[front]
        print(f"Consumer consumed: {item} from position {front}")

        buffer[front] = None
        front = (front + 1) % BUFFER_SIZE 

        mutex.release()       
        empty.release()       

        time.sleep(2)

# Create threads
producer_thread = threading.Thread(target=producer)
consumer_thread = threading.Thread(target=consumer)

# Start threads
producer_thread.start()
consumer_thread.start()

# Wait for completion
producer_thread.join()
consumer_thread.join()

print("\nProducer-Consumer execution completed.")
