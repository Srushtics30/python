#  1 : DISK SCHEDULING
def fcfs(requests, head):
    movement = 0

    for r in requests:
        movement += abs(head - r)
        head = r

    return movement

def sstf(requests, head):
    requests = requests.copy()
    movement = 0

    while requests:
        nearest = min(requests, key=lambda x: abs(head - x))
        movement += abs(head - nearest)
        head = nearest
        requests.remove(nearest)

    return movement

def cscan(requests, head, size):
    requests = sorted(requests)

    right = [r for r in requests if r >= head]
    left = [r for r in requests if r < head]

    movement = 0

    for r in right:
        movement += abs(head - r)
        head = r

    if left:
        movement += abs(head - (size - 1))
        movement += size - 1
        head = 0

        for r in left:
            movement += abs(head - r)
            head = r

    return movement

def clook(requests, head):
    requests = sorted(requests)

    right = [r for r in requests if r >= head]
    left = [r for r in requests if r < head]

    movement = 0

    for r in right:
        movement += abs(head - r)
        head = r

    if left:
        movement += abs(head - left[0])
        head = left[0]

        for r in left:
            movement += abs(head - r)
            head = r

    return movement

def rss(requests, head):
    movement = 0

    for r in requests:
        movement += abs(head - r)
        head = r

    return movement

