#  2 : SIMPLE FILE SYSTEM
files = {}

def create_file():

    name = input("Enter file name: ")
    data = input("Enter file data: ")

    if name in files:
        print("File already exists!")

    else:
        files[name] = data
        print("File created successfully!")


def read_file():

    name = input("Enter file name: ")

    if name in files:
        print("\nFile Data:", files[name])

    else:
        print("File not found!")

def delete_file():

    name = input("Enter file name: ")

    if name in files:
        del files[name]
        print("File deleted successfully!")

    else:
        print("File not found!")

def show_directory():

    print("\n----- DIRECTORY -----")

    if len(files) == 0:
        print("Directory is empty!")

    else:
        for name in files:
            print( name)

def file_system():
    while True:
        print("~" *  30)
