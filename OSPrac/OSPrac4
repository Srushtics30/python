#  CPU Scheduling Algorithms (Part 1) – FCFS and Non-preemptive Scheduling
# Simulate First-Come First-Serve scheduling. 
# Extend implementation to general non-preemptive scheduling. 
# Analyze waiting time, turnaround time, and Gantt chart generation.  

# FCFS Scheduling
print("S116 - Srushti Vedak \n")
process = ["P1", "P2", "P3", "P4"]
arrival = [0, 1, 2, 3]
burst = [5, 3, 8, 6]

waiting = []
turnaround = []

time = 0

print("-" * 20)
print("Process\tWT\tTAT")
print("-" * 20)

for i in range(len(process)):
    if time < arrival[i]:
        time = arrival[i]

    waiting.append(time - arrival[i])
    time += burst[i]
    turnaround.append(time - arrival[i])

    print(process[i], "\t", waiting[i], "\t", turnaround[i])

avg_wt = sum(waiting) / len(process)
avg_tat = sum(turnaround) / len(process)

print("\nAverage Waiting Time =", avg_wt, "ms")
print("Average Turnaround Time =", avg_tat, "ms")

print("\nGantt Chart")
print("0 | P1 | 5 | P2 | 8 | P3 | 16 | P4 | 22")


# Non-Preemptive SJF Scheduling
print("S116 - Srushti Vedak \n")
process = ["P1", "P2", "P3", "P4"]
arrival = [0, 2, 4, 5]
burst = [7, 4, 1, 4]

# Order after applying Non-Preemptive SJF:
# P1 -> P3 -> P2 -> P4

order = [0, 2, 1, 3]

waiting = [0] * 4
turnaround = [0] * 4

time = 0

for i in order:
    if time < arrival[i]:
        time = arrival[i]

    waiting[i] = time - arrival[i]
    time += burst[i]
    turnaround[i] = time - arrival[i]

print("~"*20)
print("Process\tWT\tTAT")
print("~"*20)
for i in range(4):
    print(process[i], "\t", waiting[i], "\t", turnaround[i])

avg_wt = sum(waiting) / 4
avg_tat = sum(turnaround) / 4

print("\nAverage Waiting Time =", avg_wt, "ms")
print("Average Turnaround Time =", avg_tat, "ms")

print("\nGantt Chart")
print("0 | P1 | 7 | P3 | 8 | P2 | 12 | P4 | 16")
