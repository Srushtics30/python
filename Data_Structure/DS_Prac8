    def insert_avl(self):

        value = int(self.avl_entry.get())

        self.tree_root = self.avl.insert(
            self.tree_root,
            value
        )

        self.output.insert(
            tk.END,
            f"Inserted {value} into AVL\n"
        )

    def show_tree(self):

        result = self.avl.preorder(
            self.tree_root
        )

        self.output.insert(
            tk.END,
            "\nAVL Preorder: "
            + result
            + "\n"
        )

    def add_heap(self):

        value = int(self.heap_entry.get())

        self.heap_data.append(value)

        self.output.insert(
            tk.END,
            f"Added {value} to Heap\n"
        )

    def show_heap(self):

        mini = self.heap_data.copy()

        heapq.heapify(mini)

        maxi = [-x for x in self.heap_data]

        heapq.heapify(maxi)

        maxi = [-x for x in maxi]

        self.output.insert(
            tk.END,
            f"\nMin Heap: {mini}\n"
        )

        self.output.insert(
            tk.END,
            f"Max Heap: {maxi}\n"
        )

    def add_task(self):

        task = self.task_entry.get()

        priority = int(
            self.priority_entry.get()
        )

        heapq.heappush(
            self.tasks,
            (priority, task)
        )

        self.output.insert(
            tk.END,
            f"Task Added: {task}\n"
        )

    def run_task(self):

        if self.tasks:

            p,t = heapq.heappop(
                self.tasks
            )

            self.output.insert(
                tk.END,
                f"Running Priority {p}: {t}\n"
            )

        else:

            messagebox.showinfo(
                "Empty",
                "No tasks available"
            )

