# AVL Tree
class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None
        self.height = 1

class AVLTree:

    def height(self, node):
        if node:
            return node.height
        return 0

    def balance(self, node):
        if node:
            return self.height(node.left) - self.height(node.right)
        return 0

    def rightRotate(self, y):
        x = y.left
        t = x.right

        x.right = y
        y.left = t

        y.height = 1 + max(self.height(y.left), self.height(y.right))
        x.height = 1 + max(self.height(x.left), self.height(x.right))

        print(Fore.RED + "Right Rotation on", y.key, Style.RESET_ALL)
        return x

    def leftRotate(self, x):
        y = x.right
        t = y.left

        y.left = x
        x.right = t

        x.height = 1 + max(self.height(x.left), self.height(x.right))
        y.height = 1 + max(self.height(y.left), self.height(y.right))

        print(Fore.RED + "Left Rotation on", x.key, Style.RESET_ALL)
        return y

    def insert(self, root, key):

        if root is None:
            return Node(key)

        if key < root.key:
            root.left = self.insert(root.left, key)
        else:
            root.right = self.insert(root.right, key)

        root.height = 1 + max(self.height(root.left), self.height(root.right))

        b = self.balance(root)

        # Left Left
        if b > 1 and key < root.left.key:
            return self.rightRotate(root)

        # Right Right
        if b < -1 and key > root.right.key:
            return self.leftRotate(root)

        # Left Right
        if b > 1 and key > root.left.key:
            root.left = self.leftRotate(root.left)
            return self.rightRotate(root)

        # Right Left
        if b < -1 and key < root.right.key:
            root.right = self.rightRotate(root.right)
            return self.leftRotate(root)

        return root

    def preorder(self, root):
        if root:
            print(Fore.CYAN + str(root.key) + Style.RESET_ALL, end=" ")
            self.preorder(root.left)
            self.preorder(root.right)

# Min Heap
def minHeap(data):
    heapq.heapify(data)
    print(Fore.GREEN + "Min Heap:" + Style.RESET_ALL, data)

# Max Heap
def maxHeap(data):
    heap = []

    for i in data:
        heap.append(-i)

    heapq.heapify(heap)

    result = []
    for i in heap:
        result.append(-i)

    print(Fore.YELLOW + "Max Heap:" + Style.RESET_ALL, result)

# Priority Queue
class TaskManager:

    def __init__(self):
        self.tasks = []

    def addTask(self, priority, task):
        heapq.heappush(self.tasks, (priority, task))

    def runTasks(self):
        print(Fore.MAGENTA + "\nTasks in Priority Order:" + Style.RESET_ALL)

        while self.tasks:
            p, t = heapq.heappop(self.tasks)
            print(Fore.BLUE + "Priority", p, ":", t, Style.RESET_ALL)

