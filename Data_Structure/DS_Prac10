# Aim: Write a program to create basic Hash Table for insertion, deletion, traversal operations(assume that there are no collisions) .
class HashTable:
    def __init__(self, size):
        self.size = size
        self.table = [None] * size

    def hash_function(self, key):
        return key % self.size

    # Insertion
    def insert(self, key, value):
        index = self.hash_function(key)
        self.table[index] = (key, value)
        print("Inserted successfully.")

    # Deletion
    def delete(self, key):
        index = self.hash_function(key)

        if self.table[index] is not None:
            self.table[index] = None
            print("Deleted successfully.")
        else:
            print("Key not found.")

    # Traversal
    def traverse(self):
        print("\nHash Table:")
        for i in range(self.size):
            if self.table[i] is not None:
                print(f"Index {i}: Key = {self.table[i][0]}, Value = {self.table[i][1]}")
            else:
                print(f"Index {i}: Empty")

size = int(input("Enter hash table size: "))
ht = HashTable(size)

while True:
    print("\n--- Hash Table Operations ---")
    print("1. Insert")
    print("2. Delete")
    print("3. Traverse")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        key = int(input("Enter key: "))
        value = input("Enter value: ")
        ht.insert(key, value)

    elif choice == 2:
        key = int(input("Enter key to delete: "))
        ht.delete(key)

    elif choice == 3:
        ht.traverse()

    elif choice == 4:
        print("Program terminated.")
        break

    else:
        print("Invalid choice.")


# GUI Code -
import tkinter as tk
from tkinter import messagebox

# HASH TABLE
SIZE = 7
table = [None] * SIZE

# Hash Function
def hash_function(key):
    return key % SIZE

# Insert
def insert():
    if key_entry.get() == "":
        messagebox.showwarning("Warning", "Please enter a Key!")
        return

    if value_entry.get() == "":
        messagebox.showwarning("Warning", "Please enter a Value!")
        return

    try:
        key = int(key_entry.get())
    except ValueError:
        messagebox.showerror("Error", "Key must be a number!")
        return

    value = value_entry.get()
    index = hash_function(key)

    if table[index] is None:
        table[index] = [key, value]
        messagebox.showinfo("Success", "Inserted Successfully!")
    else:
        messagebox.showerror("Error", "Collision Occurred!")

# Delete
def delete():
    if key_entry.get() == "":
        messagebox.showwarning("Warning", "Please enter a Key!")
        return

    try:
        key = int(key_entry.get())
    except ValueError:
        messagebox.showerror("Error", "Key must be a number!")
        return

    index = hash_function(key)

    if table[index] is not None:
        table[index] = None
        messagebox.showinfo("Success", "Deleted Successfully!")
    else:
        messagebox.showerror("Error", "Key Not Found!")

# Traversal
def display_table():
    result = "HASH TABLE\n"
    result += "-----------------------------\n"

    for i in range(SIZE):
        if table[i] is None:
            result += f"Index {i} : Empty\n"
        else:
            result += f"Index {i} : Key = {table[i][0]}, Value = {table[i][1]}\n"

    result += "-----------------------------"

    messagebox.showinfo("Hash Table - Traversal", result)

