import heapq
from collections import Counter
import tkinter as tk
from tkinter import scrolledtext

#Huffman Node
class Node:
    def __init__(self, char=None, freq=None):
        self.char = char
        self.freq = freq
        self.left = None
        self.right = None

    def __lt__(self, other):
        return self.freq < other.freq

# Build Huffman Tree 
def build_huffman_tree(frequencies):
    heap = [Node(char, freq) for char, freq in frequencies.items()]
    heapq.heapify(heap)

    while len(heap) > 1:
        left = heapq.heappop(heap)
        right = heapq.heappop(heap)

        merged = Node(freq=left.freq + right.freq)

        merged.left = left
        merged.right = right

        heapq.heappush(heap, merged)

    return heap[0]

#Generate Codes
def generate_codes(node, code="", codebook=None):

    if codebook is None:
        codebook = {}

    if node:

        if node.char is not None:
            codebook[node.char] = code

        generate_codes(node.left, code + "0", codebook)
        generate_codes(node.right, code + "1", codebook)

    return codebook

#Encoding
def huffman_encoding(text):

    frequencies = Counter(text)

    root = build_huffman_tree(frequencies)

    codebook = generate_codes(root)

    encoded = ""

    for char in text:
        encoded += codebook[char]

    return encoded, codebook, frequencies

#Decoding
def huffman_decoding(encoded, codebook):

    reverse = {}

    for char, code in codebook.items():
        reverse[code] = char


    decoded = ""
    current = ""

    for bit in encoded:

        current += bit

        if current in reverse:
            decoded += reverse[current]
            current = ""

    return decoded

#GUI Functions

encoded_data = ""
codebook = {}

def encode_text():

    global encoded_data, codebook

    text = input_box.get("1.0", tk.END).strip()

    if text == "":
        output_box.insert(tk.END, "Enter some text first!\n")
        return

    encoded_data, codebook, freq = huffman_encoding(text)

    output_box.delete("1.0", tk.END)

    output_box.insert(tk.END, "CHARACTER FREQUENCIES\n")
    output_box.insert(tk.END, str(dict(freq)))

    output_box.insert(tk.END, "\n\nHUFFMAN CODES\n")

    for key,value in codebook.items():
        output_box.insert(tk.END, f"{key} : {value}\n")


    output_box.insert(tk.END,"\nENCODED DATA\n")
    output_box.insert(tk.END, encoded_data)

def decode_text():

    text = input_box.get("1.0", tk.END).strip()

    decoded = huffman_decoding(encoded_data, codebook)


    output_box.insert(tk.END,"\n\nDECODED DATA\n")
