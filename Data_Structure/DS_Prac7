import heapq
from collections import Counter
from colorama import Fore, init

init(autoreset=True)

# Node class
class Node:
    def __init__(self, char=None, freq=None):
        self.char = char
        self.freq = freq
        self.left = None
        self.right = None

    # Compare nodes based on frequency
    def __lt__(self, other):
        return self.freq < other.freq

# Build Huffman Tree
def build_huffman_tree(frequencies):
    heap = [Node(char, freq) for char, freq in frequencies.items()]
    heapq.heapify(heap)

    while len(heap) > 1:
        left = heapq.heappop(heap)
        right = heapq.heappop(heap)

        merged = Node(freq=left.freq + right.freq)
        merged.left = left
        merged.right = right

        heapq.heappush(heap, merged)

        print(Fore.YELLOW + f"Merging: {left.char} ({left.freq}) + {right.char} ({right.freq})")

    return heap[0]

# Generate Huffman Codes
def generate_codes(node, code="", codebook=None):
    if codebook is None:
        codebook = {}

    if node is not None:
        if node.char is not None:
            codebook[node.char] = code
            print(Fore.GREEN + f"{node.char} -> {code}")

        generate_codes(node.left, code + "0", codebook)
        generate_codes(node.right, code + "1", codebook)

    return codebook

# Encoding
def huffman_encoding(text):
    frequencies = Counter(text)

    print(Fore.CYAN + "\nCharacter Frequencies:")
    print(dict(frequencies))

    root = build_huffman_tree(frequencies)

    print(Fore.CYAN + "\nHuffman Codes:")
    codebook = generate_codes(root)

    encoded_data = ""
    for char in text:
        encoded_data += codebook[char]

    return encoded_data, codebook

# Decoding
def huffman_decoding(encoded_data, codebook):
    reverse_codebook = {}

    for char, code in codebook.items():
        reverse_codebook[code] = char

    decoded_data = ""
    current_code = ""

    print(Fore.MAGENTA + "\nDecoding Steps:")

    for bit in encoded_data:
        current_code += bit

        if current_code in reverse_codebook:
            print(current_code, "->", reverse_codebook[current_code])
            decoded_data += reverse_codebook[current_code]
            current_code = ""

    return decoded_data

# Main Program
