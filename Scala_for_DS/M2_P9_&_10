10. Filter rows in a CSV file using Spark DataFrames where a numeric column exceeds a threshold. 
# filterrows.py
from pyspark.sql import SparkSession

# Create Spark session
spark = SparkSession.builder \
   .appName("FilterRows") \
   .master("local[*]") \
   .getOrCreate()

# Read the CSV file
df = spark.read.csv(
   "student.csv",
   header=True,
   inferSchema=True
)

# Display the original data
print("Original Data:")
df.show()

# Set the threshold
threshold = 75

# Filter rows where Marks is greater than the threshold
filtered_df = df.filter(df["Marks"] > threshold)

# Display the filtered data
print("Students with Marks greater than", threshold)
filtered_df.show()

# Stop Spark
spark.stop()

