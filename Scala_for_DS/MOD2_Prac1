# Aim : 1. Find the Pearson correlation between two lists of numbers. Implement the formula for Pearson correlation coefficient.
# Import dataset
# Find Pearson correlation coefficient.
# Interpret whether it is positive or negative relationship 
# Infer your result using Significance and the t-test
import scala.io.Source

object M2Prac1 {

 def main(args: Array[String]): Unit = {

   val file = Source.fromFile("Diabetes.csv")

   val data = file.getLines().drop(1).flatMap { line =>
     val cols = line.split(",")

     for {
       x <- cols(1).trim.toDoubleOption  
       y <- cols(5).trim.toDoubleOption  
     } yield (x, y)

   }.toList

   file.close()

   val (x, y) = data.unzip

   val n = x.length.toDouble

   val (meanX, meanY) = (x.sum / n, y.sum / n)

   val num = x.zip(y).map {
     case (xi, yi) =>
       (xi - meanX) * (yi - meanY)
   }.sum

   val den = math.sqrt(
     x.map(xi => math.pow(xi - meanX, 2)).sum *
       y.map(yi => math.pow(yi - meanY, 2)).sum
   )

   val r = if (den == 0) 0.0 else num / den

   val relation =
     if (r > 0.7) "Strong Positive"
     else if (r > 0) "Weak Positive"
     else "Negative"

   val df = n - 2

   val tStat =
     r * math.sqrt(df / (1.0 - math.pow(r, 2)))

   val isSignificant =
     math.abs(tStat) > 1.96

   println(f"Dataset Size: ${n.toInt}%d records")
   println(f"Pearson Correlation (r): $r%.2f ($relation Relationship)")
   println(f"t-Statistic: $tStat%.2f  \nSignificant at 5%% level: $isSignificant")
 }
}

