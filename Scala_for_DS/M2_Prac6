# 6. Perform logistic regression using Breeze. Classify a dataset with binary labels. 
import breeze.linalg._
import breeze.numerics.sigmoid
import scala.io.Source

object prac6 {

 def main(args: Array[String]): Unit = {

   // Read CSV
   val data =
     Source.fromFile("study.csv").getLines()
       .drop(1)
       .map(_.split(",").map(_.trim.toDouble))
       .toArray

   val samples = data.length

   println("Logistic Regression using Breeze")

   println("\nDataset Loaded")
   println(s"Samples: $samples")
   println("Features: 2")

   // Initial weights
   // w0 = intercept, w1 = StudyHours, w2 = Marks
   var weights =
     DenseVector(0.0, 0.0, 0.0)

   val learningRate = 0.0001
   val iterations = 1000

   // Training
   println("\nTraining the model...")

   for (iteration <- 0 until iterations) {

     var gradient0 = 0.0
     var gradient1 = 0.0
     var gradient2 = 0.0

     for (i <- 0 until samples) {

       val studyHours = data(i)(1)
       val marks = data(i)(2)
       val actual = data(i)(3)

       val z = weights(0) + weights(1) * studyHours + weights(2) * marks

       val probability = sigmoid(z)

       val error = probability - actual

       gradient0 += error
       gradient1 += error * studyHours
       gradient2 += error * marks
     }

     weights(0) = weights(0) - learningRate * gradient0 / samples

     weights(1) = weights(1) - learningRate * gradient1 / samples

     weights(2) = weights(2) - learningRate * gradient2 / samples
   }

   // Model Results
   println("\nModel Results")
   println(f"Intercept : ${weights(0)}%.4f")
   println(f"StudyHours: ${weights(1)}%.4f")
   println(f"Marks     : ${weights(2)}%.4f")

   // Classification Results
   println("\nClassification Results")
   println("ARG\tActual\tProbability\tPredicted")

   for (i <- 0 until samples) {

     val arg = data(i)(1)
     val marks = data(i)(2)
     val actual = data(i)(3).toInt

     val z = weights(0) + weights(1) * arg + weights(2) * marks

     val probability = sigmoid(z)

     val predicted =
       if (probability >= 0.5) 1
       else 0

     println(
       f"$arg%.2f\t$actual%d\t$probability%.4f\t\t$predicted%d"
     )
   }

   // New prediction
   val newArg = 7.0
   val newMarks = 55.0

   val newZ =
     weights(0) +
       weights(1) * newArg +
       weights(2) * newMarks

   val newProbability =
     sigmoid(newZ)

   val newPredicted =
     if (newProbability >= 0.5) 1
     else 0

   println("\nPrediction")
   println(f"ARG         : $newArg%.2f")
   println(f"Marks       : $newMarks%.2f")
   println(f"Probability : $newProbability%.4f")
   println(s"Predicted   : $newPredicted")
 }
}

