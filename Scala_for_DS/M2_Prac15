# 15. Create polynomial features from a dataset. Given a list of numbers (e.g., [1, 2, 3]), generate polynomial features up to degree 3 (e.g., [1, 1^2, 1^3, 2, 2^2, 2^3, 3, 3^2, 3^3]). 
import scala.io.Source

object PolynomialFeatures {
 def main(args: Array[String]): Unit = {

   val file = Source.fromFile("monthsales.csv")

   val lines = file.getLines().drop(1).toList

   file.close()

   for (line <- lines) {

     val data = line.split(",")

     // Get Sales_qty from CSV
     val x = data(2).toInt

     // Polynomial features
     val x2 = x * x
     val x3 = x * x * x

     println(x + "  " + x2 + "  " + x3)
   }
 }
}

