# # 4. Sort a dataset by a specific column and extract the top 5 rows.
import scala.io.Source

object Prac4 {

 case class Student(id:Int,hours:Int,marks:Int,pass:Int)

 def main(args:Array[String]):Unit={

   val students = Source.fromFile("study.csv").getLines().drop(1).map{line=>val c=line.split(",")

       Student(
         c(0).toInt,
         c(1).toInt,
         c(2).toInt,
         c(3).toInt
       )
     }.toList

   val top5=students.sortBy(- _.marks).take(5)

   println("Top 5 Students")

   top5.foreach(println)
 }
}

