# 13. Create a scatter plot of random data using Breeze-viz. Label the axes and customize the color of points.
import breeze.linalg._
import breeze.plot._
import com.github.tototoshi.csv._
import java.io.File

object prac13 {

 def main(args: Array[String]): Unit = {

   val reader = CSVReader.open(new File("medical.csv"))
   val data = reader.allWithHeaders()
   reader.close()

   val diabetes = data.filter(_("Diabetes") == "1")
   val noDiabetes = data.filter(_("Diabetes") == "0")

   def extractXY(rows: List[Map[String, String]]) = {

     val filtered = rows.filter { row =>
       row("Age").trim.nonEmpty &&
         row("PremiumPrice").trim.nonEmpty
     }

     val x = DenseVector(
       filtered.map(_("Age").trim.toDouble).toArray
     )

     val y = DenseVector(
       filtered.map(_("PremiumPrice").trim.toDouble).toArray
     )

     (x, y)
   }

   val (xDiabetes, yDiabetes) =
     extractXY(diabetes)

   val (xNoDiabetes, yNoDiabetes) =
     extractXY(noDiabetes)

   // Create Scatter Plot
   val fig = Figure()

   val plt = fig.subplot(0)

   plt.xlim = (0, 100)
   plt.ylim = (0, 50000)

   plt.title = "Age vs Premium Price"

   plt.xlabel = "Age"

   plt.ylabel = "Premium Price"

   // Diabetes
   plt += plot(
     xDiabetes,
     yDiabetes,
     '.',
     name = "Diabetes",
     colorcode = "red"
   )

   // No Diabetes
   plt += plot(
     xNoDiabetes,
     yNoDiabetes,
     '.',
     name = "No Diabetes",
     colorcode = "blue"
   )

   // Legend (Key)
   plt.legend = true

   fig.refresh()
 }
}

