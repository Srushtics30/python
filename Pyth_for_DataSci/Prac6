# 5. Pie Chart
# o Using the same scores data, make a pie chart.
# o Add percentage labels (autopct).
# o Highlight "Python for DS" by exploding its slice.
import matplotlib.pyplot as plt
import numpy as np

# Data
scores = np.array([65, 70, 74, 60])
labels = np.array(["Data Structures", "Scala for DS", "Operating System", "Python for DS"])

# Explode the "Python for DS" slice
explode = [0, 0, 0, 0.2]

# Create pie chart
plt.pie(scores, labels=labels, autopct='%1.1f%%', explode=explode)

# Add title
plt.title("Student Scores")

# Display the chart
plt.show()

