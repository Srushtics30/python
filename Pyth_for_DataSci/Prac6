# 7. Histogram
# o Generate 100 random numbers (Normal distribution).
# o Plot a histogram with 20 bins.
# o Add a grid to the plot.
import matplotlib.pyplot as plt
import numpy as np

# Generate 100 random numbers from normal distribution
x = np.random.normal(170, 10, 100)

# Create histogram with 20 bins
plt.hist(x, bins=20)

# Add grid
plt.grid(True)

# Add title and labels
plt.title("Histogram of Normal Distribution")
plt.xlabel("Values")
plt.ylabel("Frequency")

# Display the plot
plt.show()

# 8. Two Plots in One Figure
import matplotlib.pyplot as plt
import numpy as np

# Data
x = np.array([1, 2, 3, 4, 5])
y = np.array([2, 4, 6, 8, 10])

# First plot (Line plot)
plt.subplot(1, 2, 1)
plt.plot(x, y)
plt.title("Line Plot")
plt.xlabel("Numbers")
plt.ylabel("Doubles")

# Second plot (Scatter plot)
plt.subplot(1, 2, 2)
plt.scatter(x, y, color="green")
plt.title("Scatter Plot")
plt.xlabel("Numbers")
plt.ylabel("Doubles")

# Adjust layout
plt.tight_layout()

# Display the figure
plt.show()

# 9. 4 Subplots (2x2 Grid)
# o Top-left: Line plot
# o Top-right: Bar chart
# o Bottom-left: Scatter plot
# o Bottom-right: Histogram
import matplotlib.pyplot as plt
import numpy as np

# Data
x = np.array([1, 2, 3, 4, 5])
y = np.array([2, 4, 6, 8, 10])

# Create figure with 2x2 grid
# Top-left: Line plot
plt.subplot(2, 2, 1)
plt.plot(x, y)
plt.title("Line Plot")
plt.xlabel("Numbers")
plt.ylabel("Doubles")

# Top-right: Bar chart
plt.subplot(2, 2, 2)
plt.bar(x, y)
plt.title("Bar Chart")
plt.xlabel("Numbers")
plt.ylabel("Values")

# Bottom-left: Scatter plot
plt.subplot(2, 2, 3)
plt.scatter(x, y, color="green")
plt.title("Scatter Plot")
plt.xlabel("Numbers")
plt.ylabel("Values")

# Bottom-right: Histogram
plt.subplot(2, 2, 4)
data = np.random.normal(170, 10, 100)
plt.hist(data, bins=20)
plt.title("Histogram")
plt.xlabel("Values")
plt.ylabel("Frequency")

# Adjust spacing
plt.tight_layout()

# Display all plots
plt.show()

