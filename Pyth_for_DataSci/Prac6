# 3. Highlight the highest sales month of 2024 by adding an annotation on the graph.
import matplotlib.pyplot as plt
import numpy as np

# Data
months = np.array(["Jan", "Feb", "Mar", "Apr", "May", "Jun"])
sales_2023 = np.array([150, 200, 250, 300, 280, 350])
sales_2024 = np.array([180, 220, 270, 320, 300, 400])

# Plot two line charts
plt.plot(months, sales_2023, color="brown", linestyle="--", marker="o", label="Sales 2023")
plt.plot(months, sales_2024, color="orange", linestyle="-", marker="s", label="Sales 2024")

# Add annotation for highest sales month in 2024
plt.annotate(
    "Highest Sales: 400",
    xy=("Jun", 400),
    xytext=("Apr", 380),
    arrowprops=dict(facecolor="black", arrowstyle="->")
)

# Add title and labels
plt.title("Monthly Sales Comparison (2023 vs 2024)")
plt.xlabel("Months")
plt.ylabel("Sales")

# Add legend and grid
plt.legend()
plt.grid(True)

# Display graph
plt.show()

