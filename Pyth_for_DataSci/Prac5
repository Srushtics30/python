# 5d. Write a python code to demonstrate filter pandas series with Boolean arrays.    
import pandas as pd

print("S116 - Srushti Vedak")
# Create Pandas Series
marks = pd.Series([55, 72, 90, 45, 88, 60, 35])

# Display original Series
print("Original Series:")
print(marks)

# Boolean filtering (marks greater than 60)
filtered_marks = marks[marks > 60]

# Display filtered Series
print("\nFiltered Series (Marks > 60):")
print(filtered_marks)
