url = "https://www.facebook.com/"
response = requests.get(url)

# Step 2: Parse the HTML
soup = BeautifulSoup(response.text, "html.parser")

# Step 3: Extract information
# Title of the page
if soup.title:
    print("Page Title:", soup.title.string)

# All headings 
