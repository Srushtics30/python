# 5: Handling Missing Values6: Data Cleaning and Adding New Columns
import pandas as pd

data = {
    "Order_ID": ["O101", "O102", "O103", "O104", "O105", "O106"],
    "Product": ["Laptop", "Mouse", "Keyboard", "Monitor", "Laptop", "Printer"],
    "Sales": [110000, 8000, None, 48000, 165000, None],
    "Quantity": [2, None, 8, 4, None, 2]
}

df = pd.DataFrame(data)

print("~" * 20)
print("S116 - Srushti Vedak")
print("~" * 20, "\n")
print("Original Dataset:")
print(df)

# 1. Check missing values
print("\nMissing Values:")
print(df.isnull())

# 2. Count missing values
print("\nCount of Missing Values:")
print(df.isnull().sum())

# 3. Replace missing Sales with mean
df["Sales"] = df["Sales"].fillna(df["Sales"].mean())

# 4. Replace missing Quantity with mean
df["Quantity"] = df["Quantity"].fillna(df["Quantity"].mean())

print("\nCleaned Dataset:")
print(df)


# 6: Data Cleaning and Adding New Columns
import pandas as pd

df = pd.read_csv("sales.csv")

print("~" * 20)
print("S116 - Srushti Vedak")
print("~" * 20, "\n")
# Create Sales_Level column
df["Sales_Level"] = df["Sales"].apply(
    lambda x: "High" if x >= 100000
    else ("Medium" if x >= 50000 else "Low")
)

# Function to classify category
def category_type(category):

    if category == "Electronics":
        return "Electronic Item"
    else:
        return "Accessory Item"

# Create Category_Type column
df["Category_Type"] = df["Category"].apply(category_type)

print(df)


