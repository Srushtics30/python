# PART F: BEAUTIFUL SOUP
# The main dataset is already available as CSV.
# Therefore Beautiful Soup is not needed to collect the main data.
def beautiful_soup_demo():

    import requests
    from bs4 import BeautifulSoup

    url = "https://books.toscrape.com/"

    try:

        response = requests.get(
            url,
            timeout=5
        )

        soup = BeautifulSoup(
            response.text,
            "html.parser"
        )

        print("\nBeautiful Soup Demo")
        print("Website Title:")

        print(
            soup.title.text.strip()
        )

        books = soup.find_all(
            "article",
            class_="product_pod"
        )

        data = []

        for book in books:

            title = book.h3.a["title"]

            price = book.find(
                "p",
                class_="price_color"
            ).text

            data.append(
                [title, price]
            )

        scraped_df = pd.DataFrame(
            data,
            columns=["Title", "Price"]
        )

        print("\nScraped Data:")
        print(
            scraped_df.head()
        )

    except Exception as error:

        print(
            "\nBeautiful Soup demo could not run."
        )

        print(
            "This does not affect the main project."
        )

