# Create Grade column
def calculate_grade(marks):

    if marks >= 90:
        return "A+"

    elif marks >= 80:
        return "A"

    elif marks >= 70:
        return "B"

    elif marks >= 60:
        return "C"

    elif marks >= 50:
        return "D"

    else:
        return "F"


df["Grade"] = df["Marks"].apply(
    calculate_grade
)


# Create Result column
def calculate_result(marks):

    if marks >= 40:
        return "Pass"

    else:
        return "Fail"


df["Result"] = df["Marks"].apply(
    calculate_result
)


# 1. Total Records
total_records = len(df)


# 2. Total Categories
total_categories = df["Course"].nunique()


# 3. Average Marks
average_marks = np.mean(
    df["Marks"]
)


# 4. Median Marks
median_marks = np.median(
    df["Marks"]
)


# 5. Highest Marks
highest_marks = np.max(
    df["Marks"]
)


# 6. Lowest Marks
lowest_marks = np.min(
    df["Marks"]
)


# 7. Standard Deviation
std_marks = np.std(
