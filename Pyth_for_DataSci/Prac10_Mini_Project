# Function to create summary card
def create_card(
    title_text,
    value,
    color
):

    card = tk.Frame(
        card_frame,
        bg=color,
        width=220,
        height=75
    )

    card.pack(
        side="left",
        padx=8,
        expand=True
    )

    card.pack_propagate(
        False
    )

    tk.Label(
        card,
        text=title_text,
        font=("Arial", 9, "bold"),
        bg=color,
        fg=white
    ).pack(
        pady=4
    )

    tk.Label(
        card,
        text=value,
        font=("Arial", 17, "bold"),
        bg=color,
        fg=white
    ).pack()



